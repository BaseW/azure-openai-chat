{
  "name": "azure-openai-chat",
  "version": "1.0.0",
  "description": "CLI chat application using Azure OpenAI API with Ink and React",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "pnpm build && node dist/index.js",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "check": "biome check --apply --formatter-enabled=true .",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "keywords": [
    "azure",
    "openai",
    "chat",
    "cli",
    "ink",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/openai": "^1.0.0-beta.1",
    "ink": "^4.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
