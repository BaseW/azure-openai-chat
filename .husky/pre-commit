#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged to check and fix only staged files
echo "Running Biome linting and formatting on staged files..."
pnpm lint-staged || { 
  echo "❌ Biome linting or formatting failed"
  echo "Please fix the issues or use git commit --no-verify to bypass this check"
  exit 1
}

# Note: Type checking and tests will be added in later tasks

echo "✅ Pre-commit checks passed!"
